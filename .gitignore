# Dependencies
vendor/

# TYPO3 generated
var/
public/typo3temp/
public/_assets/
public/_assets_install/

# User uploads (manage separately or via shared storage)
public/fileadmin/

# Environment & local system config (generated per environment by DDEV/install tool)
config/system/additional.php
config/system/additional.ddev.php
.env
.env.*

# Site config local overrides (per deployment target)
config/sites/*/config.local.yaml

# Site settings — deploy-persisted "shared" file (see deployer/deploy.php),
# so backend/editor changes on the server survive deploys instead of being
# overwritten by whatever's committed here.
config/sites/sitepackage/settings.yaml


.ddev/db_snapshots/
.ddev/traefik/
/auth.json
/.netrc

# Database dumps
db_dump/

# setup-project transient state (removed by the script itself; ignored as a
# safety net in case a run is interrupted before cleanup)
/.setup-languages.yaml.tmp

# Claude Code workspace
.claude/

# OS & IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
