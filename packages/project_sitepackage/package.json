{
  "name": "project-sitepackage",
  "version": "1.0.0",
  "description": "Project sitepackage – TYPO3 14 build tooling",
  "private": true,
  "scripts": {
    "build": "npm run build:scss",
    "build:scss": "sass Resources/Private/Scss/main.scss Resources/Public/Css/main.css --style=compressed --load-path=node_modules",
    "dev": "sass Resources/Private/Scss/main.scss Resources/Public/Css/main.css --watch --load-path=node_modules"
  },
  "devDependencies": {
    "sass": "^1.77.0"
  }
}
