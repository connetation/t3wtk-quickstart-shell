#!/usr/bin/env bash
## Description: Initialize a fresh TYPO3 project (composer install, move sitepackage, DB setup)
## Usage: setup-project
## Example: ddev setup-project

set -euo pipefail

DDEV_CONFIG="$(pwd)/.ddev/config.yaml"
CURRENT_DDEV_NAME=$(grep "^name:" "$DDEV_CONFIG" | awk '{print $2}')

# Derive a readable default site title from the DDEV project name
DEFAULT_SITE_TITLE=$(echo "$CURRENT_DDEV_NAME" | sed 's/[-_]/ /g' | awk '{for(i=1;i<=NF;i++) $i=toupper(substr($i,1,1)) substr($i,2); print}')

# Derive default vendor/package name from the current composer.json "name" field
CURRENT_COMPOSER_NAME=$(grep -m1 '"name"' composer.json | sed -E 's/.*"name": *"([^"]*)".*/\1/')
DEFAULT_VENDOR="${CURRENT_COMPOSER_NAME%%/*}"
DEFAULT_PACKAGE="${CURRENT_COMPOSER_NAME##*/}"

# Normalize a string into a valid Composer name segment (lowercase, dash-separated)
slugify() {
    echo "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//'
}

# Escape a value for safe use inside a single-quoted SQL string literal
escape_sql() {
    printf '%s' "$1" | sed "s/'/''/g"
}

# Load the curated language menu (code|title|locale|flag|hreflang per line)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LANGUAGES_CONF="${SCRIPT_DIR}/languages.conf"
LANG_OPTIONS=()
while IFS= read -r conf_line; do
    [[ -z "$conf_line" || "$conf_line" == \#* ]] && continue
    LANG_OPTIONS+=("$conf_line")
done < "$LANGUAGES_CONF"

echo ""
echo "============================================"
echo "  TYPO3 Project Setup"
echo "============================================"
echo "  Press Enter to accept [defaults]."
echo ""
echo "  ! This will remove this repo's .git history and run 'git init',"
echo "    so the project starts from a clean slate with no link back"
echo "    to the template's remote. Make sure any work here is already"
echo "    pushed/backed up elsewhere before continuing."
echo ""

# ── Verify Composer authentication is in place ────────────────────────────────
if [ ! -f "$(pwd)/auth.json" ]; then
    echo "  ✗ auth.json not found in project root."
    echo ""
    echo "    This project installs conn/t3kit-base, conn/t3kit-elements and conn/t3kit-sitepackage"
    echo "    from the private Connetation Composer repository"
    echo "    (https://composer-v2.connetation.at/), which requires authentication."
    echo ""
    echo "    Create auth.json in the project root before running this command:"
    echo ""
    echo '      {'
    echo '          "http-basic": {'
    echo '              "composer-v2.connetation.at": {'
    echo '                  "username": "your-username",'
    echo '                  "password": "your-password"'
    echo '              }'
    echo '          }'
    echo '      }'
    echo ""
    echo "    Contact Connetation if you don't have access credentials."
    echo "    (auth.json is gitignored — it will never be committed.)"
    echo ""
    exit 1
fi

# ── Interactive prompts ───────────────────────────────────────────────────────
read -rp "  Project name   [${DEFAULT_SITE_TITLE}]: " SITE_TITLE
SITE_TITLE="${SITE_TITLE:-$DEFAULT_SITE_TITLE}"

read -rp "  DDEV subdomain [${CURRENT_DDEV_NAME}]: " INPUT_DDEV_NAME
INPUT_DDEV_NAME="${INPUT_DDEV_NAME:-$CURRENT_DDEV_NAME}"

read -rp "  Vendor name    [${DEFAULT_VENDOR}]: " INPUT_VENDOR
INPUT_VENDOR="${INPUT_VENDOR:-$DEFAULT_VENDOR}"

read -rp "  Package name   [${DEFAULT_PACKAGE}]: " INPUT_PACKAGE
INPUT_PACKAGE="${INPUT_PACKAGE:-$DEFAULT_PACKAGE}"

VENDOR_SLUG=$(slugify "$INPUT_VENDOR")
PACKAGE_SLUG=$(slugify "$INPUT_PACKAGE")

if [ -z "$VENDOR_SLUG" ] || [ -z "$PACKAGE_SLUG" ]; then
    echo ""
    echo "  ✗ Vendor name and package name must not be empty (or resolve to empty after normalization)."
    exit 1
fi

COMPOSER_NAME="${VENDOR_SLUG}/${PACKAGE_SLUG}"

read -rp "  Admin username [admin]: " ADMIN_USER
ADMIN_USER="${ADMIN_USER:-admin}"

read -rsp "  Admin password [Admin1234!]: " ADMIN_PASSWORD
echo ""
ADMIN_PASSWORD="${ADMIN_PASSWORD:-Admin1234!}"

read -rp "  Admin email    [admin@example.com]: " ADMIN_EMAIL
ADMIN_EMAIL="${ADMIN_EMAIL:-admin@example.com}"

# ── Language selection ─────────────────────────────────────────────────────────
echo ""
echo "  Available languages (first pick = default/main language):"
for i in "${!LANG_OPTIONS[@]}"; do
    IFS='|' read -r _code _title _locale _flag _hreflang <<< "${LANG_OPTIONS[$i]}"
    printf "    %2d) %s\n" "$((i + 1))" "$_title"
done
CUSTOM_CHOICE_NUM=$((${#LANG_OPTIONS[@]} + 1))
printf "    %2d) Other (enter a custom language)\n" "$CUSTOM_CHOICE_NUM"
echo ""
read -rp "  Languages (comma-separated) [1]: " LANG_SELECTION
LANG_SELECTION="${LANG_SELECTION:-1}"

SELECTED_LANGUAGES=()
declare -A SEEN_CHOICES=()
declare -A SEEN_CODES=()

IFS=',' read -ra RAW_LANG_CHOICES <<< "$LANG_SELECTION"
for choice in "${RAW_LANG_CHOICES[@]}"; do
    choice="$(echo "$choice" | tr -d '[:space:]')"
    [ -z "$choice" ] && continue

    if ! [[ "$choice" =~ ^[0-9]+$ ]]; then
        echo ""
        echo "  ✗ Invalid language selection: '${choice}'"
        exit 1
    fi

    if [ -n "${SEEN_CHOICES[$choice]:-}" ]; then
        continue
    fi
    SEEN_CHOICES[$choice]=1

    if [ "$choice" -ge 1 ] && [ "$choice" -le "${#LANG_OPTIONS[@]}" ]; then
        LANG_ENTRY="${LANG_OPTIONS[$((choice - 1))]}"
    elif [ "$choice" -eq "$CUSTOM_CHOICE_NUM" ]; then
        echo ""
        read -rp "    Language title (e.g. Nederlands): " CUSTOM_TITLE
        read -rp "    ISO 639-1 code, used in the URL path (e.g. nl): " CUSTOM_CODE
        read -rp "    Locale (e.g. nl_NL.utf8): " CUSTOM_LOCALE
        read -rp "    Flag code [Resources/Public/Icons/Flags in typo3/cms-core] (e.g. nl): " CUSTOM_FLAG
        read -rp "    hreflang [defaults to code] (e.g. nl): " CUSTOM_HREFLANG
        echo ""

        if [ -z "$CUSTOM_TITLE" ] || [ -z "$CUSTOM_CODE" ] || [ -z "$CUSTOM_LOCALE" ]; then
            echo "  ✗ Title, code and locale are required for a custom language."
            exit 1
        fi
        CUSTOM_FLAG="${CUSTOM_FLAG:-$CUSTOM_CODE}"
        CUSTOM_HREFLANG="${CUSTOM_HREFLANG:-$CUSTOM_CODE}"
        LANG_ENTRY="${CUSTOM_CODE}|${CUSTOM_TITLE}|${CUSTOM_LOCALE}|${CUSTOM_FLAG}|${CUSTOM_HREFLANG}"
    else
        echo ""
        echo "  ✗ Invalid language selection: '${choice}'"
        exit 1
    fi

    LANG_ENTRY_CODE="${LANG_ENTRY%%|*}"
    if [ -n "${SEEN_CODES[$LANG_ENTRY_CODE]:-}" ]; then
        echo ""
        echo "  ✗ Language code '${LANG_ENTRY_CODE}' selected more than once."
        exit 1
    fi
    SEEN_CODES[$LANG_ENTRY_CODE]=1

    SELECTED_LANGUAGES+=("$LANG_ENTRY")
done

if [ "${#SELECTED_LANGUAGES[@]}" -eq 0 ]; then
    echo ""
    echo "  ✗ At least one language must be selected."
    exit 1
fi

# Build the config.yaml "languages:" block and a one-line summary for display
LANG_SUMMARY=""
LANGUAGES_YAML="languages:"$'\n'
for i in "${!SELECTED_LANGUAGES[@]}"; do
    IFS='|' read -r lang_code lang_title lang_locale lang_flag lang_hreflang <<< "${SELECTED_LANGUAGES[$i]}"

    if [ "$i" -eq 0 ]; then
        lang_base="/"
        LANG_SUMMARY="${lang_title} (default)"
    else
        lang_base="/${lang_code}/"
        LANG_SUMMARY="${LANG_SUMMARY}, ${lang_title}"
    fi

    LANGUAGES_YAML+="  -"$'\n'
    LANGUAGES_YAML+="    title: ${lang_title}"$'\n'
    LANGUAGES_YAML+="    enabled: true"$'\n'
    LANGUAGES_YAML+="    languageId: ${i}"$'\n'
    LANGUAGES_YAML+="    base: ${lang_base}"$'\n'
    LANGUAGES_YAML+="    locale: ${lang_locale}"$'\n'
    LANGUAGES_YAML+="    navigationTitle: ${lang_title}"$'\n'
    LANGUAGES_YAML+="    flag: ${lang_flag}"$'\n'
    LANGUAGES_YAML+="    hreflang: '${lang_hreflang}'"$'\n'
    LANGUAGES_YAML+="    websiteTitle: ''"$'\n'
    if [ "$i" -gt 0 ]; then
        LANGUAGES_YAML+="    fallbackType: fallback"$'\n'
        LANGUAGES_YAML+="    fallbacks:"$'\n'
        LANGUAGES_YAML+="      - 0"$'\n'
    fi
done

DDEV_URL="https://${INPUT_DDEV_NAME}.ddev.site"

echo ""
echo "  Site title : ${SITE_TITLE}"
echo "  URL        : ${DDEV_URL}"
echo "  Composer   : ${COMPOSER_NAME}"
echo "  Languages  : ${LANG_SUMMARY}"
echo "  Username   : ${ADMIN_USER}"
echo "  Email      : ${ADMIN_EMAIL}"
echo ""

# ── Rename DDEV project if subdomain changed ──────────────────────────────────
if [ "$INPUT_DDEV_NAME" != "$CURRENT_DDEV_NAME" ]; then
    echo "==> Renaming DDEV project '${CURRENT_DDEV_NAME}' → '${INPUT_DDEV_NAME}'..."
    awk -v name="$INPUT_DDEV_NAME" '/^name:/ {$0 = "name: " name} 1' "$DDEV_CONFIG" > "${DDEV_CONFIG}.tmp" \
        && mv "${DDEV_CONFIG}.tmp" "$DDEV_CONFIG"
    ddev restart
    echo ""
fi

PROJECT_NAME="$INPUT_DDEV_NAME"

# ── Step 1: Set composer.json package name ────────────────────────────────────
echo "==> [1/10] Setting composer.json package name..."
ddev exec php << PHP
<?php
\$file = '/var/www/html/composer.json';
\$json = json_decode(file_get_contents(\$file), true);
\$json['name'] = '${COMPOSER_NAME}';
file_put_contents(\$file, json_encode(\$json, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n");
echo "    composer.json → name: ${COMPOSER_NAME}\n";
PHP
echo ""

# ── Step 2: Composer install ─────────────────────────────────────────────────
echo "==> [2/10] Installing Composer dependencies..."
ddev composer install
echo "    Done."
echo ""

# ── Step 3: Create required directories and patch site config ─────────────────
echo "==> [3/10] Creating required directories..."
ddev exec bash -c "mkdir -p \
    packages \
    public/fileadmin/_processed_ \
    public/fileadmin/_temp_ \
    public/fileadmin/user_upload \
    public/fileadmin/form_definitions \
    var/charset \
    var/lock \
    var/log \
    var/session \
    var/transient \
    translations"
echo "    Done."
echo ""

echo "==>       Patching site config..."
printf '%s' "$LANGUAGES_YAML" > .setup-languages.yaml.tmp
ddev exec php << PHP
<?php
\$ddevUrl     = '${DDEV_URL}';
\$siteTitle   = '${SITE_TITLE}';
\$langSummary = '${LANG_SUMMARY}';
\$file = '/var/www/html/config/sites/sitepackage/config.yaml';
\$content = file_get_contents(\$file);
\$content = preg_replace("/^base: '.*'/m",        "base: '\$ddevUrl/'",  \$content);
\$content = preg_replace("/^websiteTitle: '.*'/m", "websiteTitle: '\$siteTitle'", \$content);
\$content = preg_replace("#Sitemap: https?://\S+/sitemap\.xml#", "Sitemap: \$ddevUrl/sitemap.xml", \$content);
\$languagesYaml = rtrim(file_get_contents('/var/www/html/.setup-languages.yaml.tmp'));
\$content = preg_replace('/^languages:\n(?:.*\n)*?(?=^rootPageId:)/m', \$languagesYaml . "\n", \$content, 1);
file_put_contents(\$file, \$content);
echo "    base        → \$ddevUrl/\n";
echo "    websiteTitle → \$siteTitle\n";
echo "    robots.txt sitemap → \$ddevUrl/sitemap.xml\n";
echo "    languages   → \$langSummary\n";
PHP
rm -f .setup-languages.yaml.tmp
echo ""

# ── Step 4: Copy conn/t3kit-sitepackage to packages/t3kit-sitepackage ──────────────
echo "==> [4/10] Moving conn/t3kit-sitepackage to packages/t3kit-sitepackage/ ..."

if [ -d "packages/t3kit-sitepackage" ]; then
    echo "    packages/t3kit-sitepackage/ already exists — skipping copy."
else
    ddev exec bash -c "cp -r vendor/conn/t3kit-sitepackage packages/t3kit-sitepackage"
    echo "    Copied. Removing embedded .git..."
    ddev exec bash -c "rm -rf packages/t3kit-sitepackage/.git"
    echo "    Done."
fi
echo ""

# ── Step 5: Update composer.json to use local path package ───────────────────
echo "==> [5/10] Switching sitepackage to local path repository..."

ddev exec php << 'PHP'
<?php
$root = '/var/www/html';

$pkgJsonPath = $root . '/packages/t3kit-sitepackage/composer.json';
$pkg = json_decode(file_get_contents($pkgJsonPath), true);
$pkg['version'] = 'dev-local';
file_put_contents($pkgJsonPath, json_encode($pkg, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n");

$composerJsonPath = $root . '/composer.json';
$json = json_decode(file_get_contents($composerJsonPath), true);
$json['require']['conn/t3kit-sitepackage'] = 'dev-local';
$json['repositories'] = array_values(array_filter(
    $json['repositories'],
    fn($r) => !($r['type'] === 'vcs' && str_contains($r['url'], 'sitepackage'))
));
file_put_contents($composerJsonPath, json_encode($json, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n");

echo "    packages/t3kit-sitepackage/composer.json → version: dev-local\n";
echo "    composer.json → conn/t3kit-sitepackage dev-local, VCS repo removed\n";
PHP

echo ""

# ── Step 6: Rewire composer to use packages/t3kit-sitepackage ──────────────────────
echo "==> [6/10] Updating Composer to use packages/t3kit-sitepackage/ ..."
ddev composer update conn/t3kit-sitepackage --no-interaction
echo "    Done. vendor/conn/t3kit-sitepackage → symlink to packages/t3kit-sitepackage/"
echo ""

# ── Step 7: TYPO3 setup ──────────────────────────────────────────────────────
echo "==> [7/10] Initializing TYPO3 (database schema + admin user)..."

SKIP_TYPO3_SETUP=false

DB_TABLE_COUNT=$(ddev exec bash -c "mysql -uroot -proot -e \"SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='db';\" --skip-column-names 2>/dev/null || echo 0")
DB_TABLE_COUNT=$(echo "$DB_TABLE_COUNT" | tr -d '[:space:]')

if [ "${DB_TABLE_COUNT:-0}" -gt 0 ] 2>/dev/null; then
    echo ""
    echo "  ! Database already contains ${DB_TABLE_COUNT} tables."
    echo "    [d] Drop database and re-initialise (loses all data)"
    echo "    [s] Skip TYPO3 setup and keep existing database"
    echo ""
    read -r -p "  Choice [d/s]: " DB_CHOICE
    echo ""

    case "$DB_CHOICE" in
        d|D)
            echo "    Dropping database..."
            ddev exec bash -c "mysql -uroot -proot -e 'DROP DATABASE IF EXISTS db; CREATE DATABASE db CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;'"
            echo "    Done."
            ;;
        s|S)
            SKIP_TYPO3_SETUP=true
            echo "    Keeping existing database."
            ;;
        *)
            echo "    Invalid choice. Aborting."
            exit 1
            ;;
    esac
fi

if [ "$SKIP_TYPO3_SETUP" = false ]; then
    echo "    Running TYPO3 setup (this may take a moment)..."
    ddev exec \
        env "TYPO3_SETUP_ADMIN_PASSWORD=${ADMIN_PASSWORD}" "TYPO3_SETUP_ADMIN_EMAIL=${ADMIN_EMAIL}" \
        bash -c "vendor/bin/typo3 setup \
            --no-interaction \
            --driver=mysqli \
            --host=db \
            --port=3306 \
            --dbname=db \
            --username=db \
            --password=db \
            --admin-username='${ADMIN_USER}' \
            --project-name='${SITE_TITLE}' \
            --server-type=apache \
            --force"
fi
echo ""

if [ "$SKIP_TYPO3_SETUP" = false ]; then
    echo "==>       Creating default pages..."

    ADMIN_UID=$(printf "SELECT uid FROM be_users WHERE username='%s' LIMIT 1;\n" "$(escape_sql "$ADMIN_USER")" \
        | ddev exec bash -c "mysql -uroot -proot db -N" | tr -d '[:space:]')
    ADMIN_UID="${ADMIN_UID:-1}"

    SITE_TITLE_SQL=$(escape_sql "$SITE_TITLE")

    cat <<SQL | ddev exec bash -c "mysql -uroot -proot db"
INSERT INTO pages (pid, tstamp, crdate, title, slug, doktype, is_siteroot, hidden, nav_hide, perms_userid, perms_user, perms_group, perms_everybody, sorting)
VALUES (0, UNIX_TIMESTAMP(), UNIX_TIMESTAMP(), '${SITE_TITLE_SQL}', '/', 1, 1, 0, 0, ${ADMIN_UID}, 31, 27, 1, 256);

INSERT INTO pages (pid, tstamp, crdate, title, slug, doktype, is_siteroot, hidden, nav_hide, perms_userid, perms_user, perms_group, perms_everybody, sorting)
VALUES (1, UNIX_TIMESTAMP(), UNIX_TIMESTAMP(), 'Seite nicht gefunden', '/seite-nicht-gefunden', 1, 0, 0, 1, ${ADMIN_UID}, 31, 27, 1, 256);
SQL

    echo "    uid=1 → root page ('${SITE_TITLE}'), marked as site root"
    echo "    uid=2 → 'Seite nicht gefunden' (active, hidden in menu — used by config.yaml's 404 errorHandling)"
fi
echo ""

echo "==>       Setting up extensions and flushing cache..."
ddev exec vendor/bin/typo3 extension:setup
ddev exec vendor/bin/typo3 cache:flush
echo "    Done."
echo ""

echo "==>       Setting trusted hosts pattern for DDEV..."
ddev exec vendor/bin/typo3 configuration:set SYS/trustedHostsPattern ".+\.ddev\.site"
echo "    Done."
echo ""

# ── Step 8: Build sitepackage styles (only when SCSS sources are present) ────
echo "==> [8/10] Building sitepackage CSS..."
if ddev exec bash -c "test -f /var/www/html/packages/t3kit-sitepackage/package.json"; then
    ddev exec bash -c "cd /var/www/html/packages/t3kit-sitepackage && npm install && npm run build"
    echo "    Done."
else
    echo "    Skipped — packages/t3kit-sitepackage/package.json not found."
    echo "    The sitepackage was installed from a dist archive (no SCSS build tools)."
    echo "    Pre-compiled CSS from the distribution will be used as-is."
fi
echo ""

# ── Step 9: Warm caches — avoids a transient failure window on first visit ───
# Right after extension:setup/composer settle packages/t3kit-sitepackage as the
# local path package, the FIRST few frontend requests can hit a stale
# TypoScript/Sets compile (e.g. EXT:form's FormFrontend template resolving to
# the wrong root path until things settle) — crawling every page here forces
# that compile to happen now, before anyone loads the site themselves.
echo "==> [9/10] Warming caches..."
ddev exec vendor/bin/typo3 cache:warmup || true
ddev exec vendor/bin/typo3 conn:warmup --insecure || echo "    (warmup crawl reported an issue — non-fatal, continuing)"
echo "    Done."
echo ""

# ── Step 10: Reset git history — start this project from a clean slate ───────
echo "==> [10/10] Resetting git history for a fresh project..."
rm -rf .git
git init -q
echo "    Done. Template history removed, empty repository initialized."
echo ""

# ── Done ─────────────────────────────────────────────────────────────────────
echo "============================================"
echo "  Setup complete!"
echo "============================================"
echo ""
echo "  Backend : ${DDEV_URL}/typo3"
echo "  Username: ${ADMIN_USER}"
echo "  Password: ${ADMIN_PASSWORD}"
echo "  Email   : ${ADMIN_EMAIL}"
echo ""
echo "  Next steps:"
echo "  1. Commit the project as your initial commit:"
echo "       git add -A"
echo "       git commit -m 'Initial commit'"
echo ""
echo "  2. Log into TYPO3 backend — the root page (uid=1, site root) and the"
echo "     'Seite nicht gefunden' page (uid=2, used as the 404 page) are"
echo "     already in place, ready to fill with content"
echo ""
echo "  3. Customize packages/t3kit-sitepackage/ to your needs,"
echo "     rebuild CSS with: ddev exec 'cd /var/www/html/packages/t3kit-sitepackage && npm run build'"
echo ""
echo "  4. Before deploying, update:"
echo "       deployer/deploy.php        (server hostname, user, path)"
echo "       .gitlab-ci.yml             (PRODUCTION_HOST, PRODUCTION_USER)"
echo "       config/sites/sitepackage/config.yaml  (production base URL)"
echo ""
