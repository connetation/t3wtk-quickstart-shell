#!/usr/bin/env bash
## Description: Initialize a fresh TYPO3 project (composer install, move sitepackage, DB setup)
## Usage: setup-project [--admin-password=<password>] [--admin-email=<email>]
## Example: ddev setup-project
## Example: ddev setup-project --admin-password=MySecurePass1! --admin-email=dev@example.com

set -euo pipefail

# ── Defaults ─────────────────────────────────────────────────────────────────
ADMIN_PASSWORD="Admin1234!"
ADMIN_EMAIL="admin@example.com"

# Parse optional arguments
for arg in "$@"; do
    case "$arg" in
        --admin-password=*) ADMIN_PASSWORD="${arg#*=}" ;;
        --admin-email=*)    ADMIN_EMAIL="${arg#*=}" ;;
    esac
done

PROJECT_NAME=$(grep "^name:" "$(pwd)/.ddev/config.yaml" | awk '{print $2}')
DDEV_URL="https://${PROJECT_NAME}.ddev.site"

echo ""
echo "============================================"
echo "  TYPO3 Project Setup"
echo "  URL: ${DDEV_URL}"
echo "============================================"
echo ""

# ── Step 1: Composer install ─────────────────────────────────────────────────
echo "==> [1/7] Installing Composer dependencies..."
ddev composer install
echo "    Done."
echo ""

# ── Step 2: Create required directories ──────────────────────────────────────
echo "==> [2/7] Creating required directories..."
ddev exec bash -c "mkdir -p \
    packages \
    public/fileadmin/_processed_ \
    public/fileadmin/_temp_ \
    public/fileadmin/user_upload \
    public/fileadmin/form_definitions \
    var/charset \
    var/lock \
    var/log \
    var/session \
    var/transient \
    translations"
echo "    Done."
echo ""

# ── Step 3: Copy conn/sitepackage to packages/sitepackage ────────────────────
echo "==> [3/7] Moving conn/sitepackage to packages/sitepackage/ ..."

if [ -d "packages/sitepackage" ]; then
    echo "    packages/sitepackage/ already exists — skipping copy."
else
    ddev exec bash -c "cp -r vendor/conn/sitepackage packages/sitepackage"
    echo "    Copied. Removing embedded .git..."
    ddev exec bash -c "rm -rf packages/sitepackage/.git"
    echo "    Done."
fi
echo ""

# ── Step 4: Update composer.json to use local path package ───────────────────
echo "==> [4/7] Switching sitepackage to local path repository..."

ddev exec php << 'PHP'
<?php
$root = '/var/www/html';

// Add version to packages/sitepackage/composer.json so path repo resolves correctly
$pkgJsonPath = $root . '/packages/sitepackage/composer.json';
$pkg = json_decode(file_get_contents($pkgJsonPath), true);
$pkg['version'] = 'dev-local';
file_put_contents($pkgJsonPath, json_encode($pkg, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n");

// Update root composer.json:
//   - change conn/sitepackage constraint to @dev (matches dev-local from path repo)
//   - remove the VCS gitlab repository for sitepackage (no longer needed)
$composerJsonPath = $root . '/composer.json';
$json = json_decode(file_get_contents($composerJsonPath), true);

$json['require']['conn/sitepackage'] = '@dev';

$json['repositories'] = array_values(array_filter(
    $json['repositories'],
    fn($r) => !($r['type'] === 'vcs' && str_contains($r['url'], 'sitepackage'))
));

file_put_contents($composerJsonPath, json_encode($json, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n");

echo "    packages/sitepackage/composer.json → added version: dev-local\n";
echo "    composer.json → conn/sitepackage set to @dev, VCS repo removed\n";
PHP

echo ""

# ── Step 5: Update composer to use local package ─────────────────────────────
echo "==> [5/7] Updating Composer to use packages/sitepackage/ ..."
ddev composer update conn/sitepackage --no-interaction
echo "    Done. vendor/conn/sitepackage → symlink to packages/sitepackage/"
echo ""

# ── Step 6: TYPO3 setup ──────────────────────────────────────────────────────
echo "==> [6/7] Initializing TYPO3 (database schema + admin user)..."
echo "    This may take a moment..."
ddev exec env "TYPO3_SETUP_ADMIN_PASSWORD=$ADMIN_PASSWORD" "TYPO3_SETUP_ADMIN_EMAIL=$ADMIN_EMAIL" bash -c "vendor/bin/typo3 setup \
    --no-interaction \
    --driver=mysqli \
    --host=db \
    --port=3306 \
    --dbname=db \
    --username=db \
    --password=db \
    --admin-username=admin \
    '--project-name=My TYPO3 Project' \
    --server-type=apache \
    --force"
echo ""

echo "==> [6/7] Setting up extensions and flushing cache..."
ddev exec vendor/bin/typo3 extension:setup
ddev exec vendor/bin/typo3 cache:flush
echo "    Done."
echo ""

# ── Step 7: Build sitepackage styles ─────────────────────────────────────────
echo "==> [7/7] Building sitepackage CSS..."
ddev exec bash -c "cd /var/www/html/packages/sitepackage && npm install && npm run build"
echo "    Done."
echo ""

# ── Done ─────────────────────────────────────────────────────────────────────
echo "============================================"
echo "  Setup complete!"
echo "============================================"
echo ""
echo "  Backend: ${DDEV_URL}/typo3"
echo "  Username: admin"
echo "  Password: ${ADMIN_PASSWORD}"
echo "  Email:    ${ADMIN_EMAIL}"
echo ""
echo "  Next steps:"
echo "  1. Commit the local sitepackage to this project's git:"
echo "       git add packages/sitepackage/ composer.json composer.lock"
echo "       git commit -m 'Initialize sitepackage'"
echo ""
echo "  2. Log into TYPO3 backend, create a root page,"
echo "     mark it as 'Site Root', then configure in Site Management"
echo ""
echo "  3. Customize packages/sitepackage/ to your needs,"
echo "     rebuild CSS with: ddev exec 'cd /var/www/html/packages/sitepackage && npm run build'"
echo ""
echo "  4. Before deploying, update:"
echo "       deployer/deploy.php        (server hostname, user, path)"
echo "       .gitlab-ci.yml             (PRODUCTION_HOST, PRODUCTION_USER)"
echo "       config/sites/sitepackage/config.yaml  (production base URL)"
echo ""
