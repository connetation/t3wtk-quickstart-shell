#!/usr/bin/env bash
## Description: Download database dump from a remote environment
## Usage: pull-db [environment]
## Example: ddev pull-db master

set -euo pipefail

ENVIRONMENT="${1:-master}"
CONFIG_FILE="$(dirname "${BASH_SOURCE[0]}")/pull-db.yaml"

if [[ ! -f "$CONFIG_FILE" ]]; then
    echo "Error: $CONFIG_FILE not found"
    exit 1
fi

yaml_get() {
    local env="$1" key="$2"
    awk -v env="$env" -v key="$key" '
        /^  [^ ]/ { in_env = ($0 ~ "^  " env ":$") }
        in_env { if (match($0, "^    " key ":")) { sub("^    " key ": *", ""); print; exit } }
    ' "$CONFIG_FILE"
}

if ! awk -v env="$ENVIRONMENT" '/^  [^ ]/ { if ($0 ~ "^  " env ":$") found=1 } END { exit !found }' "$CONFIG_FILE"; then
    AVAILABLE=$(awk '/^  [^ ]/ { gsub(/^  |:.*$/, ""); printf "%s ", $0 }' "$CONFIG_FILE")
    echo "Error: Unknown environment '$ENVIRONMENT'. Available: $AVAILABLE" >&2
    exit 1
fi

REMOTE_HOST=$(yaml_get "$ENVIRONMENT" "host")
REMOTE_USER=$(yaml_get "$ENVIRONMENT" "user")
REMOTE_PORT=$(yaml_get "$ENVIRONMENT" "port")
REMOTE_PATH=$(yaml_get "$ENVIRONMENT" "path")
REMOTE_TYPE=$(yaml_get "$ENVIRONMENT" "type")

REMOTE_USER="${REMOTE_USER:-root}"
REMOTE_PORT="${REMOTE_PORT:-22}"
REMOTE_TYPE="${REMOTE_TYPE:-classic}"

mkdir -p "$(pwd)/db_dump"
OUTFILE="$(pwd)/db_dump/${ENVIRONMENT}_$(date +%Y%m%d_%H%M).sql.gz"

echo "Downloading database from $ENVIRONMENT ($REMOTE_USER@$REMOTE_HOST)..."

if [[ "$REMOTE_TYPE" == "docker" ]]; then
    # Docker Compose deployment (see compose.prod.yaml): the DB has no port
    # published on the host, and credentials only exist as env vars inside the
    # running containers (.env.docker is never rsynced to the host as-is by
    # the actual file, and is gitignored). So run mariadb-dump *inside* the db
    # container, where MARIADB_USER/MARIADB_PASSWORD/MARIADB_DATABASE are
    # already set by `env_file: .env.docker`, instead of trying to read them
    # from a settings.php that doesn't exist on a docker host.
    COMPOSE_FILE=$(yaml_get "$ENVIRONMENT" "compose_file")
    SERVICE=$(yaml_get "$ENVIRONMENT" "service")
    COMPOSE_FILE="${COMPOSE_FILE:-compose.prod.yaml}"
    SERVICE="${SERVICE:-db}"

    REMOTE_CMD="cd '$REMOTE_PATH' && docker compose -f '$COMPOSE_FILE' exec -T '$SERVICE' sh -c 'exec mariadb-dump --single-transaction --default-character-set=utf8mb4 -u\"\$MARIADB_USER\" -p\"\$MARIADB_PASSWORD\" \"\$MARIADB_DATABASE\"'"

    ssh -p "$REMOTE_PORT" -o StrictHostKeyChecking=accept-new "$REMOTE_USER@$REMOTE_HOST" "$REMOTE_CMD" | gzip > "$OUTFILE"
else
    ssh -p "$REMOTE_PORT" -o StrictHostKeyChecking=accept-new "$REMOTE_USER@$REMOTE_HOST" "php8.2 /dev/stdin '$REMOTE_PATH'" << 'PHPEOF' > "$OUTFILE"
<?php
// Mirrors TYPO3's own bootstrap order: settings.php is merged in first, then
// additional.php is included and always wins, since that's the whole point
// of additional.php (e.g. per-environment DB overrides not committed to git).
$settingsPath = $argv[1] . '/config/system';
$GLOBALS['TYPO3_CONF_VARS'] = [];
foreach (['settings.php', 'additional.php'] as $file) {
    $fullPath = $settingsPath . '/' . $file;
    if (file_exists($fullPath)) {
        $loaded = include($fullPath);
        if (is_array($loaded)) {
            $GLOBALS['TYPO3_CONF_VARS'] = array_replace_recursive($GLOBALS['TYPO3_CONF_VARS'], $loaded);
        }
    }
}
$db = $GLOBALS['TYPO3_CONF_VARS']['DB']['Connections']['Default'] ?? [];
if (empty($db)) {
    fwrite(STDERR, "ERROR: Could not read DB credentials from TYPO3 config\n");
    exit(1);
}
$cmd = sprintf(
    'mysqldump --single-transaction --default-character-set=utf8mb4 -h %s -P %d -u %s -p%s %s | gzip',
    escapeshellarg($db['host'] ?: 'localhost'),
    (int)($db['port'] ?: 3306),
    escapeshellarg($db['user']),
    escapeshellarg($db['password']),
    escapeshellarg($db['dbname'])
);
passthru($cmd);
PHPEOF
fi

echo "Saved to: $OUTFILE"
echo "Import with: ddev import-db --file=$OUTFILE"
echo "If $ENVIRONMENT still runs t3kit (tx_conn_t3kit_* tables), migrate it after importing:"
echo "  ddev exec vendor/bin/typo3 cache:flush"
echo "  ddev exec vendor/bin/typo3 upgrade:run connT3wtkBaseMigrateFromT3kit"
echo "  ddev exec vendor/bin/typo3 extension:setup"
