#!/usr/bin/env bash
## Description: Download database dump from a remote environment
## Usage: pull-db [environment]
## Example: ddev pull-db master

set -euo pipefail

ENVIRONMENT="${1:-master}"
CONFIG_FILE="$(dirname "${BASH_SOURCE[0]}")/pull-db.yaml"

if [[ ! -f "$CONFIG_FILE" ]]; then
    echo "Error: $CONFIG_FILE not found. Configure your environments in .ddev/commands/host/pull-db.yaml"
    exit 1
fi

yaml_get() {
    local env="$1" key="$2"
    awk -v env="$env" -v key="$key" '
        /^  [^ ]/ { in_env = ($0 ~ "^  " env ":$") }
        in_env { if (match($0, "^    " key ":")) { sub("^    " key ": *", ""); print; exit } }
    ' "$CONFIG_FILE"
}

if ! awk -v env="$ENVIRONMENT" '/^  [^ ]/ { if ($0 ~ "^  " env ":$") found=1 } END { exit !found }' "$CONFIG_FILE"; then
    AVAILABLE=$(awk '/^  [^ ]/ { gsub(/^  |:.*$/, ""); printf "%s ", $0 }' "$CONFIG_FILE")
    echo "Error: Unknown environment '$ENVIRONMENT'. Available: $AVAILABLE" >&2
    exit 1
fi

REMOTE_HOST=$(yaml_get "$ENVIRONMENT" "host")
REMOTE_USER=$(yaml_get "$ENVIRONMENT" "user")
REMOTE_PORT=$(yaml_get "$ENVIRONMENT" "port")
REMOTE_PATH=$(yaml_get "$ENVIRONMENT" "path")

REMOTE_USER="${REMOTE_USER:-root}"
REMOTE_PORT="${REMOTE_PORT:-22}"

mkdir -p "$(pwd)/db_dump"
OUTFILE="$(pwd)/db_dump/${ENVIRONMENT}_$(date +%Y%m%d_%H%M).sql.gz"

echo "Downloading database from $ENVIRONMENT ($REMOTE_USER@$REMOTE_HOST)..."

ssh -p "$REMOTE_PORT" -o StrictHostKeyChecking=accept-new "$REMOTE_USER@$REMOTE_HOST" "php8.2 /dev/stdin '$REMOTE_PATH'" << 'PHPEOF' > "$OUTFILE"
<?php
$settingsPath = $argv[1] . '/config/system';
$GLOBALS['TYPO3_CONF_VARS'] = [];
$c = [];
foreach (['settings.php', 'additional.php'] as $file) {
    $fullPath = $settingsPath . '/' . $file;
    if (file_exists($fullPath)) {
        $loaded = include($fullPath);
        if (is_array($loaded) && isset($loaded['DB'])) {
            $c = array_replace_recursive($c, $loaded);
        }
    }
}
if (empty($c['DB']['Connections']['Default']['user']) && !empty($GLOBALS['TYPO3_CONF_VARS']['DB']['Connections']['Default']['user'])) {
    $c = array_replace_recursive($c, ['DB' => $GLOBALS['TYPO3_CONF_VARS']['DB']]);
}
if (empty($c['DB']['Connections']['Default'])) {
    fwrite(STDERR, "ERROR: Could not read DB credentials from TYPO3 config\n");
    exit(1);
}
$db = $c['DB']['Connections']['Default'];
$cmd = sprintf(
    'mysqldump --single-transaction --default-character-set=utf8mb4 -h %s -P %d -u %s -p%s %s | gzip',
    escapeshellarg($db['host'] ?: 'localhost'),
    (int)($db['port'] ?: 3306),
    escapeshellarg($db['user']),
    escapeshellarg($db['password']),
    escapeshellarg($db['dbname'])
);
passthru($cmd);
PHPEOF

echo "Saved to: $OUTFILE"
echo "Import with: ddev import-db --file=$OUTFILE"
