{
    "name": "your-vendor/your-project",
    "description": "TYPO3 14 project built on Connetation base packages",
    "license": "GPL-2.0-or-later",
    "type": "project",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "platform": {
            "php": "8.3.0"
        },
        "preferred-install": {
            "conn/t3kit-sitepackage": "source"
        },
        "sort-packages": true
    },
    "require": {
        "b13/container": "^3.2",
        "conn/t3kit-base": "^2.0.0",
        "conn/t3kit-elements": "^2.0.0",
        "conn/t3kit-sitepackage": "^2.0.0",
        "typo3/cms-adminpanel": "^14.3",
        "typo3/cms-backend": "^14.3",
        "typo3/cms-belog": "^14.3",
        "typo3/cms-beuser": "^14.3",
        "typo3/cms-core": "^14.3",
        "typo3/cms-dashboard": "^14.3",
        "typo3/cms-extbase": "^14.3",
        "typo3/cms-extensionmanager": "^14.3",
        "typo3/cms-felogin": "^14.3",
        "typo3/cms-filelist": "^14.3",
        "typo3/cms-filemetadata": "^14.3",
        "typo3/cms-fluid": "^14.3",
        "typo3/cms-fluid-styled-content": "^14.3",
        "typo3/cms-form": "^14.3",
        "typo3/cms-frontend": "^14.3",
        "typo3/cms-impexp": "^14.3",
        "typo3/cms-info": "^14.3",
        "typo3/cms-install": "^14.3",
        "typo3/cms-lowlevel": "^14.3",
        "typo3/cms-reactions": "^14.3",
        "typo3/cms-recycler": "^14.3",
        "typo3/cms-redirects": "^14.3",
        "typo3/cms-reports": "^14.3",
        "typo3/cms-rte-ckeditor": "^14.3",
        "typo3/cms-scheduler": "^14.3",
        "typo3/cms-seo": "^14.3",
        "typo3/cms-setup": "^14.3",
        "typo3/cms-sys-note": "^14.3",
        "typo3/cms-tstemplate": "^14.3",
        "typo3/cms-viewpage": "^14.3",
        "typo3/cms-webhooks": "^14.3"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/*"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.com/connetation/toolkit/t3kit-sitepackage.git"
        },
        {
            "type": "composer",
            "url": "https://composer-v2.connetation.at/",
            "exclude": ["conn/t3kit-sitepackage"]
        },
        {
            "type": "composer",
            "url": "https://composer.typo3.org/"
        }
    ]
}
